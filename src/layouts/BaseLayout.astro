---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "fs² 的个人博客",
  description = "fs² 的个人博客",
} = Astro.props;
---

<!doctype html>

<html lang="zh-CN">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <meta
    name="description"
    content={description}
  />

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <title>{title}</title>

</head>

<body>

  <slot />

</body>

</html>