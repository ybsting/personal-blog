---
import {
  getCollection,
  render,
} from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";


/* =====================================================
   获取文章
===================================================== */

export async function getStaticPaths() {

  const posts =
    await getCollection(
      "posts"
    );


  return posts.map(
    (post) => ({

      params: {
        slug: post.id,
      },

      props: {
        post,
      },

    })
  );

}


const { post } =
  Astro.props;


const {
  Content,
} = await render(post);


/* =====================================================
   日期
===================================================== */

const formattedDate =
  post.data.date
    .toLocaleDateString(
      "zh-CN",
      {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
      }
    )
    .replaceAll(
      "/",
      "."
    );

---


<BaseLayout
  title={`${post.data.title} · fs² 的个人博客`}
  description={
    post.data.description ??
    post.data.title
  }
>


  <main class="article-page">


    <!-- =================================================
         顶部潮汐
    ================================================== -->

    <div
      class="article-tide"
      aria-hidden="true"
    >

      <svg
        class="article-tide-svg"
        viewBox="0 0 1200 64"
        preserveAspectRatio="none"
      >

        <defs>

          <path
            id="article-wave"
            d="
              M0 32

              C70 10,
              130 10,
              200 32

              S330 54,
              400 32

              S530 10,
              600 32

              S730 54,
              800 32

              S930 10,
              1000 32

              S1130 54,
              1200 32
            "
          />

        </defs>


        <g class="article-wave-group">


          <!-- ---------------------------------------------
               远层潮汐
          ---------------------------------------------- -->

          <use
            href="#article-wave"
            class="article-wave article-wave-back"
          />


          <!-- ---------------------------------------------
               中层潮汐
          ---------------------------------------------- -->

          <use
            href="#article-wave"
            class="article-wave article-wave-middle"
          />


          <!-- ---------------------------------------------
               前层潮汐
          ---------------------------------------------- -->

          <use
            href="#article-wave"
            class="article-wave article-wave-front"
          />


        </g>

      </svg>

    </div>


    <!-- =================================================
         文章
    ================================================== -->

    <article>


      <!-- =================================================
           标题
      ================================================== -->

      <header class="article-header">


        <time>
          {formattedDate}
        </time>


        <h1>
          {post.data.title}
        </h1>


        {
          post.data.description && (
            <p>
              {post.data.description}
            </p>
          )
        }


      </header>


      <!-- =================================================
           正文
      ================================================== -->

      <div class="article-content">

        <Content />

      </div>


    </article>


  </main>


</BaseLayout>



<style>

/* =====================================================
   文章页面
===================================================== */

.article-page {

  position:
    relative;

  min-height:
    100vh;

  background:
    rgb(
      252,
      252,
      252
    );

  color:
    #171717;

}


/* =====================================================
   顶部潮汐
===================================================== */

.article-tide {

  position:
    absolute;

  z-index:
    2;

  /*
   * 整体向下移动
   *
   * 原来：0
   * 现在：20px
   */

  top:
    14px;

  left:
    0;

  width:
    100%;

  /*
   * 波浪区域更高，
   * 给更大的起伏留空间。
   */

  height:
    64px;

  overflow:
    visible;

  pointer-events:
    none;

  opacity:
    0;

  transform:
    translate3d(
      0,
      -4px,
      0
    );

  animation:
    articleTideAppear
    1.8s
    cubic-bezier(
      0.22,
      1,
      0.36,
      1
    )
    forwards;

}


/* =====================================================
   SVG
===================================================== */

.article-tide-svg {

  display:
    block;

  width:
    100%;

  height:
    64px;

  overflow:
    visible;

}


/* =====================================================
   波浪组
===================================================== */

.article-wave-group {

  fill:
    none;

}


/* =====================================================
   波浪基础
===================================================== */

.article-wave {

  fill:
    none !important;

  stroke-linecap:
    round;

  stroke-linejoin:
    round;

  vector-effect:
    non-scaling-stroke;

}


/* =====================================================
   远层
===================================================== */

.article-wave-back {

  stroke:
    rgba(
      70,
      155,
      210,
      0.13
    );

  stroke-width:
    0.8;

  animation:
    articleWaveBack
    14s
    ease-in-out
    infinite;

}


/* =====================================================
   中层
===================================================== */

.article-wave-middle {

  stroke:
    rgba(
      50,
      140,
      205,
      0.18
    );

  stroke-width:
    0.9;

  animation:
    articleWaveMiddle
    10s
    ease-in-out
    infinite;

}


/* =====================================================
   前层
===================================================== */

.article-wave-front {

  stroke:
    rgba(
      35,
      125,
      195,
      0.23
    );

  stroke-width:
    1;

  animation:
    articleWaveFront
    7.5s
    ease-in-out
    infinite;

}


/* =====================================================
   潮汐进入
===================================================== */

@keyframes articleTideAppear {

  0% {

    opacity:
      0;

    transform:
      translate3d(
        0,
        -7px,
        0
      );

  }


  45% {

    opacity:
      0.55;

  }


  100% {

    opacity:
      1;

    transform:
      translate3d(
        0,
        0,
        0
      );

  }

}


/* =====================================================
   远层波浪
===================================================== */

@keyframes articleWaveBack {

  0% {

    transform:
      translate3d(
        -45px,
        3px,
        0
      );

  }


  25% {

    transform:
      translate3d(
        -5px,
        -6px,
        0
      );

  }


  50% {

    transform:
      translate3d(
        35px,
        4px,
        0
      );

  }


  75% {

    transform:
      translate3d(
        70px,
        -5px,
        0
      );

  }


  100% {

    transform:
      translate3d(
        105px,
        3px,
        0
      );

  }

}


/* =====================================================
   中层波浪
===================================================== */

@keyframes articleWaveMiddle {

  0% {

    transform:
      translate3d(
        45px,
        4px,
        0
      );

  }


  25% {

    transform:
      translate3d(
        10px,
        -8px,
        0
      );

  }


  50% {

    transform:
      translate3d(
        -30px,
        5px,
        0
      );

  }


  75% {

    transform:
      translate3d(
        -65px,
        -6px,
        0
      );

  }


  100% {

    transform:
      translate3d(
        -105px,
        4px,
        0
      );

  }

}


/* =====================================================
   前层波浪
===================================================== */

@keyframes articleWaveFront {

  0% {

    transform:
      translate3d(
        -25px,
        0,
        0
      );

  }


  20% {

    transform:
      translate3d(
        5px,
        -9px,
        0
      );

  }


  40% {

    transform:
      translate3d(
        35px,
        6px,
        0
      );

  }


  60% {

    transform:
      translate3d(
        65px,
        -8px,
        0
      );

  }


  80% {

    transform:
      translate3d(
        95px,
        5px,
        0
      );

  }


  100% {

    transform:
      translate3d(
        130px,
        0,
        0
      );

  }

}


/* =====================================================
   文章主体
===================================================== */

.article-page article {

  position:
    relative;

  z-index:
    1;

  width:
    min(
      760px,
      calc(
        100% - 48px
      )
    );

  margin:
    0 auto;

  /*
   * 保持上一版的上移效果。
   */

  padding:
    88px
    0
    160px;

}


/* =====================================================
   标题区域
===================================================== */

.article-header {

  margin-bottom:
    80px;

}


/* =====================================================
   日期
===================================================== */

.article-header time {

  display:
    inline-block;

  font-family:
    "SF Mono",
    "Cascadia Code",
    monospace;

  font-size:
    12px;

  letter-spacing:
    0.04em;

  color:
    rgba(
      35,
      125,
      185,
      0.68
    );

}


/* =====================================================
   标题
===================================================== */

.article-header h1 {

  margin:
    24px
    0;

  font-family:
    "Noto Serif SC",
    "Songti SC",
    "STSong",
    serif;

  font-size:
    clamp(
      34px,
      5vw,
      56px
    );

  font-weight:
    400;

  line-height:
    1.35;

  letter-spacing:
    0.01em;

  color:
    #171717;

}


/* =====================================================
   描述
===================================================== */

.article-header p {

  margin:
    0;

  color:
    rgba(
      0,
      0,
      0,
      0.48
    );

  font-size:
    15px;

  line-height:
    1.8;

}


/* =====================================================
   正文
===================================================== */

.article-content {

  font-family:
    "Noto Serif SC",
    "Songti SC",
    "STSong",
    serif;

  font-size:
    17px;

  line-height:
    2;

  color:
    #292929;

}


/* =====================================================
   二级标题
===================================================== */

.article-content :global(h2) {

  position:
    relative;

  margin:
    70px
    0
    25px;

  font-size:
    28px;

  font-weight:
    500;

  line-height:
    1.5;

}


.article-content :global(h2)::before {

  content:
    "";

  position:
    absolute;

  left:
    -18px;

  top:
    0.35em;

  width:
    2px;

  height:
    1.1em;

  border-radius:
    2px;

  background:
    rgba(
      45,
      140,
      205,
      0.35
    );

}


/* =====================================================
   三级标题
===================================================== */

.article-content :global(h3) {

  margin:
    50px
    0
    20px;

  font-size:
    22px;

  font-weight:
    500;

  line-height:
    1.5;

}


/* =====================================================
   段落
===================================================== */

.article-content :global(p) {

  margin:
    0
    0
    28px;

}


/* =====================================================
   图片
===================================================== */

.article-content :global(img) {

  display:
    block;

  max-width:
    100%;

  margin:
    45px
    auto;

}


/* =====================================================
   引用
===================================================== */

.article-content :global(blockquote) {

  margin:
    40px
    0;

  padding:
    8px
    0
    8px
    24px;

  border-left:
    2px solid
    rgba(
      45,
      140,
      205,
      0.30
    );

  color:
    rgba(
      0,
      0,
      0,
      0.55
    );

}


/* =====================================================
   列表
===================================================== */

.article-content :global(ul),
.article-content :global(ol) {

  margin:
    0
    0
    30px;

  padding-left:
    28px;

}


.article-content :global(li) {

  margin-bottom:
    8px;

}


/* =====================================================
   行内代码
===================================================== */

.article-content :global(code) {

  font-family:
    monospace;

}


/* =====================================================
   代码块
   保持原来的默认灰色风格
===================================================== */

.article-content :global(pre) {

  overflow-x:
    auto;

  padding:
    24px;

  border-radius:
    8px;

  background:
    #f1f1f1;

  font-family:
    "SF Mono",
    "Cascadia Code",
    monospace;

  font-size:
    14px;

  line-height:
    1.7;

}


/* =====================================================
   pre 内部 code
===================================================== */

.article-content :global(pre code) {

  padding:
    0;

  background:
    transparent;

  color:
    inherit;

  font-family:
    "SF Mono",
    "Cascadia Code",
    monospace;

}


/* =====================================================
   超链接
===================================================== */

.article-content :global(a) {

  color:
    #1478b9;

  text-decoration:
    underline;

  text-decoration-color:
    rgba(
      20,
      120,
      185,
      0.25
    );

  text-underline-offset:
    3px;

  transition:
    color
    220ms
    ease,

    text-decoration-color
    220ms
    ease;

}


.article-content :global(a:hover) {

  color:
    #0b6098;

  text-decoration-color:
    rgba(
      20,
      120,
      185,
      0.65
    );

}


/* =====================================================
   分割线
===================================================== */

.article-content :global(hr) {

  margin:
    65px
    0;

  border:
    0;

  border-top:
    1px solid
    rgba(
      35,
      125,
      180,
      0.12
    );

}


/* =====================================================
   手机
===================================================== */

@media (max-width: 700px) {


  /* -----------------------------------------------
     潮汐
  ----------------------------------------------- */

  .article-tide {

    top:
      10px;

    height:
      46px;

  }


  .article-tide-svg {

    height:
      46px;

  }


  /* -----------------------------------------------
     文章主体
  ----------------------------------------------- */

  .article-page article {

    width:
      calc(
        100% - 40px
      );

    padding:
      65px
      0
      110px;

  }


  /* -----------------------------------------------
     标题
  ----------------------------------------------- */

  .article-header {

    margin-bottom:
      55px;

  }


  .article-header h1 {

    margin:
      20px
      0;

    font-size:
      34px;

  }


  .article-header p {

    font-size:
      14px;

  }


  /* -----------------------------------------------
     正文
  ----------------------------------------------- */

  .article-content {

    font-size:
      16px;

    line-height:
      1.9;

  }


  .article-content :global(h2) {

    margin:
      55px
      0
      22px;

    font-size:
      25px;

  }


  .article-content :global(h2)::before {

    left:
      -12px;

    width:
      2px;

  }


  .article-content :global(h3) {

    margin:
      42px
      0
      18px;

    font-size:
      21px;

  }


  .article-content :global(blockquote) {

    margin:
      32px
      0;

    padding-left:
      18px;

  }


  .article-content :global(pre) {

    margin:
      30px
      0;

    padding:
      18px;

    border-radius:
      6px;

    font-size:
      13px;

  }

}


/* =====================================================
   减少动态效果
===================================================== */

@media (prefers-reduced-motion: reduce) {

  .article-tide {

    animation:
      none;

    opacity:
      1;

    transform:
      none;

  }


  .article-wave {

    animation:
      none;

  }

}

</style>